# ── LLM (obrigatório) ─────────────────────────────────────────────
# Qualquer API compatível com OpenAI. Exemplos:
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat
#   OpenAI:    LLM_BASE_URL=https://api.openai.com     LLM_MODEL=gpt-4o-mini
#   Anthropic (via gateway compatível) também funciona.
LLM_API_KEY=coloque-sua-chave-aqui
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Captação de leads (opcional, mas recomendado) ─────────────────
# URL do Web App do Google Apps Script que grava na planilha.
# Veja o passo a passo no README.md.
SHEETS_WEBHOOK_URL=

# ── GitHub (opcional) ─────────────────────────────────────────────
# Token com escopo public_repo aumenta o limite de requisições da
# API do GitHub de 60/hora para 5000/hora. Crie em github.com/settings/tokens
GITHUB_TOKEN=

# ── Controle de custo ─────────────────────────────────────────────
# Máximo de análises por IP por hora (padrão 3)
RATE_LIMIT_PER_HOUR=3
# Máximo de análises no total por dia (padrão 100) — protege seu saldo de API
DAILY_ANALYSIS_CAP=100
